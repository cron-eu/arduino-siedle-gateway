	(text "Q1 follows the gate voltage filtered by R1/C1 (about 2 s), so the stage\ndraws a steady current and looks like a large inductor to the bus.\nQ2/R2 limit the current to about 55 mA. Values from the simulation\n(hardware/bus-power/gyrator.cir), to be confirmed on the breadboard."
		(exclude_from_sim no)
		(at 20.32 83.2875 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "0bb2e175-d4ea-5070-ae86-f2945c6f9239")
	)
	(text "Bus input"
		(exclude_from_sim no)
		(at 20.32 25.4 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "17548843-f071-555d-8c2b-ea772d41a1c8")
	)
	(text "Filter and 5 V"
		(exclude_from_sim no)
		(at 20.32 141.2475 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "340dfa12-e0b0-5fee-bb20-f663eb90b5d1")
	)
	(text "VOUT / 11 to GPIO36 (ADC1). The firmware starts Wi-Fi only above\nabout 14 V, or the stage stalls (doc/Bus-Power.md)."
		(exclude_from_sim no)
		(at 20.32 204.1125 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "8cd73938-1967-5068-9ca3-9071cea88f14")
	)
	(text "Gyrator"
		(exclude_from_sim no)
		(at 20.32 78.2075 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "a80c64e6-4aad-569e-be36-15e6e4d58363")
	)
	(text "Two-stage RC filter: the capacitors deliver the Wi-Fi bursts and\nbridge 65 ms data frames. U1 takes 6.5-40 V. D2 keeps a USB cable on\nthe D1 Mini from feeding back into U1. Cut JP1 to run the board from\nJ2 (external 5 V) only."
		(exclude_from_sim no)
		(at 20.32 146.3275 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "ccae0dab-4ddf-5d41-b23f-2ca771e493e1")
	)
	(text "VOUT monitor"
		(exclude_from_sim no)
		(at 20.32 199.0325 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "e2abe8b5-4b1c-5e34-8ce7-ff92266d329b")
	)
	(text "Ta is +, Tb is - and board ground. F1 protects the building's bus from\nfaults on our side, TVS1 clamps surges. Data, receive and send circuits\nconnect to BUS, before D1 (doc/Bus-Power.md)."
		(exclude_from_sim no)
		(at 20.32 30.48 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "f59b7d19-f879-5b74-a20f-ce854b859194")
	)
