# Project defaults, applied on top of the ESP-IDF defaults when sdkconfig is (re)generated.
# The target is chosen with `idf.py set-target esp32|esp32s3`, sdkconfig itself is not committed.

# Flash layout: 4 MB, two OTA slots, see partitions.csv
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Roll back to the previous image if a freshly updated one does not confirm itself (see ota component)
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Keep crash dumps in flash for post mortem analysis (`idf.py coredump-info`)
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y

# Reboot if a task hangs
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10

CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096

# TLS: verify servers against the bundled root CAs (includes the Amazon roots used by AWS IoT) and check
# certificate validity dates, which is why MQTT waits for SNTP before connecting.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_CMN=y
CONFIG_MBEDTLS_HAVE_TIME_DATE=y

# Captive portal probes (iOS, Android) send long headers and open many connections at once
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_LWIP_MAX_SOCKETS=16

# Drop queued MQTT messages after a minute, a late doorbell notification is worse than none
CONFIG_MQTT_USE_CUSTOM_CONFIG=y
CONFIG_MQTT_OUTBOX_EXPIRED_TIMEOUT_MS=60000
