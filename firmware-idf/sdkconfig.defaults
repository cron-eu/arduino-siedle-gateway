# Project defaults, applied on top of the ESP-IDF defaults when sdkconfig is (re)generated.
# The target is chosen with `idf.py set-target esp32|esp32s3`, sdkconfig itself is not committed.

# Flash layout: 4 MB, two OTA slots, see partitions.csv
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Keep crash dumps in flash for post mortem analysis (`idf.py coredump-info`)
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y

# Reboot if a task hangs
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10

CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096

# Captive portal probes (iOS, Android) send long headers and open many connections at once
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_LWIP_MAX_SOCKETS=16
